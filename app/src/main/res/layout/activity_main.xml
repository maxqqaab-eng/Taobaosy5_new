<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">


        <!-- 标题 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="20dp"

            android:paddingBottom="4dp"
            android:text="📦 数据上传 Hook 模块"
            android:textColor="#333333"
            android:textSize="22sp" />


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingBottom="12dp"
            android:text="支持淘宝 &amp; 拼多多 · 多分身"
            android:textColor="#888888"
            android:textSize="13sp" />

        <!-- 设备序列号 -->
        <TextView
            android:id="@+id/tv_device_serial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#E3F2FD"
            android:padding="12dp"
            android:textColor="#1976D2"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- 权限状态 -->
        <TextView
            android:id="@+id/tv_permission_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFF3E0"
            android:padding="12dp"
            android:textColor="#E65100"
            android:textSize="13sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="16dp" />

        <!-- 模块状态 -->
        <TextView
            android:id="@+id/tv_module_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#E8F5E9"
            android:padding="16dp"
            android:textColor="#2E7D32"
            android:textSize="14sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="16dp" />

        <!-- 配置文件状态卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/white"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📂 配置文件状态"
                android:textColor="#333333"
                android:textSize="17sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="配置目录：/sdcard/flash/"
                android:textColor="#666666"
                android:textSize="12sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="8dp" />

            <TextView
                android:id="@+id/tv_config_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FAFAFA"
                android:lineSpacingExtra="4dp"
                android:padding="12dp"
                android:textColor="#333333"
                android:textSize="13sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="16dp" />

        <!-- 刷新按钮 -->
        <Button
            android:id="@+id/btn_refresh"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#126099"
            android:padding="14dp"
            android:text="🔄  刷新配置状态"
            android:textColor="@android:color/white"
            android:textSize="16sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="12dp" />

        <!-- 创建示例配置按钮 -->
        <Button
            android:id="@+id/btn_create_sample"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#8A2020"
            android:padding="14dp"
            android:text="📝  创建示例配置文件"
            android:textColor="@android:color/white"
            android:textSize="16sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="24dp" />

    </LinearLayout>
</ScrollView>
